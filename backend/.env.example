# ─────────────────────────────────────────────────────────────
# Kadamba backend environment
# Copy to .env for local dev. In production (Render) set these in
# the dashboard. Values marked REQUIRED must be present in production
# or the server refuses to start.
# ─────────────────────────────────────────────────────────────

# Server
PORT=4000                       # Render injects PORT automatically; do not override there
NODE_ENV=development            # set to "production" on Render
FRONTEND_URL=http://localhost:3002,http://localhost:5173,http://localhost:4173
# Production: comma-separated https origins, no trailing slash, e.g.
# FRONTEND_URL=https://kadambastudio.com,https://www.kadambastudio.com

# Number of proxy hops to trust (Render/Vercel LB). Prod default is 1.
TRUST_PROXY=0

# Logging: error | warn | info | debug
LOG_LEVEL=debug

# Database — REQUIRED (use MongoDB Atlas in production)
MONGODB_URI=mongodb://localhost:27017/kadamba

# Auth — REQUIRED. JWT_SECRET must be >= 32 random chars in production.
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars

# Access token: short-lived, kept in the SPA's memory (never localStorage).
JWT_EXPIRES_IN=15m
# Refresh token: rotating and single-use; stored hashed, delivered as an
# httpOnly cookie scoped to /api/auth and /api/portal.
REFRESH_EXPIRES_IN=30d

# Token claims — must be stable across deploys or every session is invalidated.
JWT_ISSUER=kadamba-api
JWT_AUDIENCE=kadamba-web

# Refresh cookie policy.
#   dev  (localhost:5173 -> localhost:4000): sameSite=lax,  secure=false
#   prod (Vercel -> Render, cross-site):      sameSite=none, secure=true
# Defaults follow NODE_ENV; only set these to override.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false
# Optional parent-domain sharing, e.g. .kadambastudio.com. Empty = host-only.
# COOKIE_DOMAIN=
# ACCESS_COOKIE_NAME=kadamba_at
# REFRESH_COOKIE_NAME=kadamba_rt

# Brute-force lockout: after MAX_FAILED_LOGINS within the window, the account
# is locked for LOCKOUT_MINUTES.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Require TOTP enrolment for admin accounts. Left off by default so the first
# deploy does not lock the sole admin out; enable once a recovery path exists.
REQUIRE_ADMIN_MFA=false

# Uploads — "local" (disk / Persistent Disk) or "azure" (Azure Blob Storage).
UPLOAD_STORAGE=local
# Azure Blob Storage (required when UPLOAD_STORAGE=azure)
# Provide EITHER AZURE_STORAGE_CONNECTION_STRING OR Account Name + Key:
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_ACCOUNT=kadambastore
# AZURE_STORAGE_KEY=your_storage_account_key
# AZURE_STORAGE_CONTAINER=kadamba-media
# Optional custom CDN / Azure Front Door base URL (without trailing slash)
# AZURE_STORAGE_PUBLIC_URL=https://cdn.kadambastudio.com/kadamba-media
# Canonical uploads directory. Defaults to <cwd>/uploads, which is where the
# existing files already live. On Render set this to the Persistent Disk mount
# (see render.yaml) so uploads survive deploys.
# UPLOAD_DIR=/var/data/uploads
# BACKUP_DIR=/var/data/backups
# Optional: absolute API origin for local file URLs (Render sets RENDER_EXTERNAL_URL automatically)
# PUBLIC_API_URL=https://your-api.onrender.com

# Image pipeline (sharp). Originals are stored untouched; variants are written
# to <UPLOAD_DIR>/optimized/<sha256>/<width>.<ext>.
IMAGE_OPTIMIZE=true
# Widths generated per upload. Never upscaled past the source width.
IMAGE_WIDTHS=400,800,1200,1600,2400
# AVIF encode ceiling (AVIF is slower than WebP/JPEG, so larger widths skip it).
IMAGE_AVIF_MAX_WIDTH=1600
# Decompression-bomb guard: reject sources above this many pixels.
IMAGE_MAX_PIXELS=80000000
IMAGE_WEBP_QUALITY=82
IMAGE_AVIF_QUALITY=62
IMAGE_JPEG_QUALITY=84

# Email (Nodemailer) — required for contact/lead notifications
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="Kadamba Studio <your_email@example.com>"
EMAIL_TO=studio@example.com     # admin inbox for form notifications

# First-admin bootstrap (used only by `npm run seed:admin`, then unset).
# Generate a strong password, e.g.: node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_NAME=Studio Admin
ADMIN_EMAIL=admin@kadambastudio.com
ADMIN_PASSWORD=change_me_via_env_never_commit_a_real_password
